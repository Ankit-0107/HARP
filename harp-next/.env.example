# --- Content ---------------------------------------------------------------
# "harp"      → HARP business content (unverified items are marked [TBD])  [default]
# "reference" → original Precept reference copy, for visual comparison only
CONTENT_SOURCE=harp

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (server-side only — never prefix with NEXT_PUBLIC_) -------------
RESEND_API_KEY=
RESEND_FROM="HARP <no-reply@your-verified-domain.tld>"
CONTACT_TO_EMAIL=
# Optional: Resend Segment id for newsletter sign-ups. If empty, sign-ups are emailed to CONTACT_TO_EMAIL instead.
RESEND_SEGMENT_ID=
